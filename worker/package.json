{
  "name": "memocho-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply memocho-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply memocho-db --remote",
    "db:seed:local": "wrangler d1 execute memocho-db --local --file=./db/seed.sql",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.35",
    "@cloudflare/workers-types": "^4.20241205.0",
    "typescript": "~5.8.3",
    "vitest": "^2.1.8",
    "wrangler": "3.99.0"
  }
}
